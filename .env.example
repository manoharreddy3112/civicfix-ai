# ============================================================================
# CivicFix AI - root environment file used by docker-compose.yml
# Copy this file to `.env` and edit the values.  NEVER commit the real .env
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ============================================================================

# --- MongoDB credentials (used to bootstrap the mongo container) -----------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-strong-password

# --- Backend secrets --------------------------------------------------------
# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- OpenAI (optional) -----------------------------------------------------
# Leave OPENAI_API_KEY empty to run the clearly-labelled RULE-BASED DEMO MODE.
# The whole app remains fully functional in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint.
#   Host Ollama (Windows/Mac) : http://host.docker.internal:11434/v1
#   Google Gemini (free tier) : https://generativelanguage.googleapis.com/v1beta/openai/
#   Leave empty to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# --- Seeded administrator account (created by `npm run seed`) --------------
ADMIN_NAME=CivicFix Administrator
ADMIN_EMAIL=admin@civicfix.ai
ADMIN_PASSWORD=Admin@12345

# --- Ports -----------------------------------------------------------------
API_PORT=5000
WEB_PORT=8080
