# ============================================================================
# CivicFix AI - frontend environment variables
# Copy to `frontend/.env` if you need to override the defaults.
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser, and
# they end up in the shipped bundle. NEVER put secrets (API keys, JWT secrets)
# in this file - the OpenAI key lives ONLY on the backend.
# ============================================================================

# Base URL of the API. Leave as "/api":
#   - dev   -> Vite proxies /api to http://localhost:5000
#   - prod  -> nginx proxies /api to the api container
# Only change this if the API is hosted on a different origin.
VITE_API_URL=/api

# Where the Vite dev server proxies /api during development.
VITE_PROXY_TARGET=http://localhost:5000
