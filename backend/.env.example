# ============================================================================
# CivicFix AI - backend environment variables
# Copy to `backend/.env` and edit. NEVER commit the real .env file.
# ============================================================================

NODE_ENV=development
PORT=5000

# --- Database ---------------------------------------------------------------
# Option A: Docker compose Mongo
#   mongodb://admin:changeme123@localhost:27017/civicfix?authSource=admin
# Option B: Local MongoDB install
#   mongodb://127.0.0.1:27017/civicfix
# Option C: MongoDB Atlas (cloud)
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/civicfix
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# --- Auth -------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- AI provider (OpenAI or any OpenAI-compatible endpoint) -----------------
# Leave OPENAI_API_KEY EMPTY to activate the rule-based DEMO MODE (clearly
# labelled in the UI). Set it to use a real LLM.
OPENAI_API_KEY=

# Optional: point the AI layer at any OpenAI-compatible provider's free tier
# instead of the official OpenAI API. Leave empty for OpenAI.
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq          : https://api.groq.com/openai/v1
#   OpenRouter    : https://openrouter.ai/api/v1
#   Ollama (local): http://localhost:11434/v1
OPENAI_BASE_URL=

# Model is fully configurable - any chat-completions model works.
#   OpenAI : gpt-4o-mini        Groq : llama-3.3-70b-versatile
#   Gemini : gemini-flash-latest Ollama: llama3.2:3b
OPENAI_MODEL=gpt-4o-mini

# --- CORS -------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# --- Seeded administrator ---------------------------------------------------
ADMIN_NAME=CivicFix Administrator
ADMIN_EMAIL=admin@civicfix.ai
ADMIN_PASSWORD=Admin@12345
# Set to "true" to auto-create the admin on server start (used by Docker).
SEED_ADMIN_ON_START=false
